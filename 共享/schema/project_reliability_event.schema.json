{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_reliability_event.schema.json",
  "type": "object",
  "required": ["event_id","task_id","stage_id","timestamp","timestamp_source","event_type","detected_by","evidence_refs","correlation_id"],
  "properties": {
    "event_id": {"type":"string","minLength":1},
    "task_id": {"type":"string","minLength":1},
    "stage_id": {"type":"string","minLength":1},
    "timestamp": {"type":"string","format":"date-time"},
    "timestamp_source": {"enum":["SYSTEM_CLOCK","PROVIDER"]},
    "event_type": {"enum":["AI_REWORK_EVENT","DRIFT_DETECTED","DRIFT_CORRECTED","FAILURE_EVENT","RECOVERY_ATTEMPT","AUTO_RECOVERY_SUCCESS","HUMAN_INTERVENTION_REQUIRED","FAKE_PASS_BLOCKED","GATE_FAILED","REGRESSION_DETECTED","SUSPEND_EVENT","RESUME_EVENT","HANDOFF_EVENT","USER_SCOPE_CHANGE","EXTERNAL_FAILURE","APPROVED_ARCHITECTURE_CHANGE","CORRECTION_EVENT","STAGE_STARTED","STAGE_PASSED","STAGE_REOPENED","TOKEN_USAGE_RECORDED","PROJECT_COMPLETED","ILLEGAL_PASSIVE_STOP","RECOVERY_EXHAUSTED","SAFE_ROLLBACK_ATTEMPT","SAFE_ROLLBACK_SUCCESS","HUMAN_RECOVERY_REQUIRED","RESUME_REQUEST","RESUME_VERIFICATION_PASS","RESUME_VERIFICATION_FAIL","RESOURCE_BUDGET_WARNING","PROACTIVE_HANDOFF_STARTED","MODEL_HANDOFF_READY","MODEL_HANDOFF_COMPLETED","HANDOFF_VERIFICATION_FAIL","UNVERIFIED_PARTIAL_WORK"]},
    "detected_by": {"type":"string","minLength":1},
    "evidence_refs": {"type":"array","items":{"type":"string","minLength":1}},
    "correlation_id": {"type":"string","minLength":1},
    "root_cause": {"type":"string"},
    "root_cause_category": {"enum":["AI_ERROR","USER_CHANGE","EXTERNAL_FAILURE","APPROVED_CHANGE"]},
    "affected_work": {"type":"array","items":{"type":"string"}},
    "recovery_action": {"type":"string"},
    "outcome": {"type":"string"},
    "drift_type": {"type":"string"},
    "expected": {}, "actual": {},
    "source_drift_event_id": {"type":"string"},
    "failure_event_id": {"type":"string"},
    "recovery_attempt_event_id": {"type":"string"},
    "new_test_evidence": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "source_event_id": {"type":"string"},
    "correction_action": {"enum":["VOID"]},
    "gate_id": {"type":"string"}, "next_legal_action": {"type":"string"}, "human_recovery_package_ref": {"type":"string"}, "suspend_event_id": {"type":"string"}, "resume_request_event_id": {"type":"string"},
    "reason": {"type":"string"},
    "blocking_condition": {"type":"string"},
    "first_pass": {"type":"boolean"},
    "token_usage": {
      "type":"object",
      "required":["input_tokens","output_tokens","cached_tokens","total_tokens","provider_evidence"],
      "properties":{"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"cached_tokens":{"type":"integer","minimum":0},"total_tokens":{"type":"integer","minimum":0},"provider_evidence":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "prev_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "event_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if":{"properties":{"event_type":{"const":"AI_REWORK_EVENT"}}},"then":{"required":["root_cause","root_cause_category","affected_work","recovery_action","outcome"],"properties":{"root_cause_category":{"const":"AI_ERROR"}}}},
    {"if":{"properties":{"event_type":{"const":"DRIFT_DETECTED"}}},"then":{"required":["drift_type","expected","actual"]}},
    {"if":{"properties":{"event_type":{"const":"DRIFT_CORRECTED"}}},"then":{"required":["source_drift_event_id"]}},
    {"if":{"properties":{"event_type":{"const":"AUTO_RECOVERY_SUCCESS"}}},"then":{"required":["failure_event_id","recovery_attempt_event_id","new_test_evidence"]}},
    {"if":{"properties":{"event_type":{"const":"GATE_FAILED"}}},"then":{"required":["gate_id","reason","blocking_condition"]}},
    {"if":{"properties":{"event_type":{"const":"CORRECTION_EVENT"}}},"then":{"required":["source_event_id","correction_action","reason"]}},
    {"if":{"properties":{"event_type":{"const":"STAGE_PASSED"}}},"then":{"required":["first_pass"]}},
    {"if":{"properties":{"event_type":{"const":"TOKEN_USAGE_RECORDED"}}},"then":{"required":["token_usage"]}},
    {"if":{"properties":{"event_type":{"const":"ILLEGAL_PASSIVE_STOP"}}},"then":{"required":["next_legal_action"]}},
    {"if":{"properties":{"event_type":{"enum":["RECOVERY_EXHAUSTED","HUMAN_RECOVERY_REQUIRED"]}}},"then":{"required":["human_recovery_package_ref"]}},
    {"if":{"properties":{"event_type":{"const":"RESUME_REQUEST"}}},"then":{"required":["suspend_event_id"]}},
    {"if":{"properties":{"event_type":{"enum":["RESUME_VERIFICATION_PASS","RESUME_VERIFICATION_FAIL"]}}},"then":{"required":["resume_request_event_id"]}}
  ],
  "additionalProperties": true
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"project_delivery_metrics.schema.json",
  "type":"object",
  "required":["task_id","event_count","reliability","recovery","continuity","stage_quality","derived","token_metrics","time_metrics","source_log_sha256"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "event_count":{"type":"integer","minimum":0},
    "reliability":{"type":"object","required":["ai_rework_count","drift_detected_count","drift_corrected_count","fake_pass_blocked_count","regression_detected_count","gate_failed_count"],"additionalProperties":{"type":"integer","minimum":0}},
    "recovery":{"type":"object","required":["recovery_attempt_count","auto_recovery_success_count","human_intervention_count"],"additionalProperties":{"type":"integer","minimum":0}},
    "continuity":{"type":"object","required":["suspend_count","resume_count","handoff_count"],"additionalProperties":{"type":"integer","minimum":0}},
    "stage_quality":{"type":"object","required":["total_stages","first_pass_stage_count","reopened_stage_count"],"additionalProperties":{"type":"integer","minimum":0}},
    "derived":{"type":"object","required":["drift_correction_rate","auto_recovery_rate","first_pass_stage_rate"]},
    "token_metrics":{"oneOf":[{"type":"object","required":["status"],"properties":{"status":{"const":"NOT_AVAILABLE"}},"additionalProperties":false},{"type":"object","required":["status","input_tokens","output_tokens","cached_tokens","total_tokens","tokens_by_stage","tokens_by_rework","tokens_by_recovery"],"properties":{"status":{"const":"AVAILABLE"},"input_tokens":{"type":"integer","minimum":0},"output_tokens":{"type":"integer","minimum":0},"cached_tokens":{"type":"integer","minimum":0},"total_tokens":{"type":"integer","minimum":0},"tokens_by_stage":{"type":"object"},"tokens_by_rework":{"type":"integer","minimum":0},"tokens_by_recovery":{"type":"integer","minimum":0}},"additionalProperties":false}]},
    "time_metrics":{"type":"object","required":["status"],"properties":{"status":{"enum":["AVAILABLE","NOT_AVAILABLE"]},"project_elapsed_seconds":{"type":"number","minimum":0}}},
    "source_log_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties":false
}
